# Copy to .env (docker compose reads it) or export these in your terminal before `python app.py`
SECRET_KEY=change-this-long-random-string
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx        # Razorpay Dashboard -> Account & Settings -> API Keys (Test Mode = free)
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
BRAVE_API_KEY=                                # optional: Brave Search API key (free tier) for product-NAME review search
